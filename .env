RESOURCE_APPLICATION=/api/v1/solicitudes
R2DBC_HOST=postgres
R2DBC_DATABASE=applications_db
R2DBC_SCHEMA=public
R2DBC_USERNAME=postgres
R2DBC_PASSWORD=postgres

CLIENT_USER_HOST=http://auth-service:8080

CLIENT_USER_BY_DOCUMENT_NUMBER=/api/v1/usuarios/{documentNumber}
CLIENT_USERS_BY_EMAILS=/api/v1/usuarios/by-emails
KEYSTORE_LOCATION=/app/cert/applications-keystore.jceks
KEYSTORE_PASSWORD=changeit
KEY_ALIAS=jwt-signer

# Spring
SPRING_PROFILES_ACTIVE=docker
JAVA_OPTS=-Xmx512m -Xms256m
